{
  "name": "board-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "echo 'Server runs via tsx — no compile step needed'",
    "preview": "npm run build && node_modules/.bin/tsx server/index.ts",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "docker:build": "docker build -t board-studio ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.18",
    "vitest": "^3.1.2"
  }
}
