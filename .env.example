# Board Studio — Environment Variables
#
# Frontend (.env in repo root, loaded by Vite):
# --------------------------------------------
# Optional: URL of the Atlas proxy server. Defaults to same-origin (empty string).
# Only needed if the proxy runs on a different origin than the dev server.
# VITE_ATLAS_PROXY_BASE=http://localhost:3001
#
# Backend (set in your shell or a separate .env file loaded by the proxy server):
# -------------------------------------------------------------------------------
# Required: Your Atlas Cloud API key.
ATLASCLOUD_API_KEY=your_atlas_cloud_api_key_here
#
# Optional: Override the Atlas Cloud base URL. Defaults to https://api.atlascloud.ai/api/v1
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
#
# Optional: Port for the proxy server. Defaults to 3001.
# PORT=3001
