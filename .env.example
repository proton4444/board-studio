# Board Studio — Environment Variables
#
# FRONTEND (.env in repo root, loaded by Vite)
# --------------------------------------------
# Optional: base URL of the Atlas proxy when it runs on a different origin.
# Leave unset (or empty) when the proxy and frontend share the same origin.
# In dev: Vite's built-in proxy forwards /api → http://localhost:3001 automatically.
# VITE_ATLAS_PROXY_BASE=
#
# BACKEND (set in shell or a .env file loaded by the proxy process — NOT loaded by Vite)
# --------------------------------------------------------------------------------------
# Required: Atlas Cloud API key. Never expose this to the browser or commit it to git.
ATLASCLOUD_API_KEY=your_atlas_cloud_api_key_here
#
# Optional: Override the Atlas Cloud base URL.
# Default: https://api.atlascloud.ai/api/v1
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
#
# Optional: Port for the Express proxy server.
# Default: 3001
# PORT=3001
